<resources>
    <style name="AppTheme" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">#0b1622</item>
        <item name="android:statusBarColor">#0b1622</item>
        <item name="android:navigationBarColor">#0b1622</item>
    </style>
    <color name="ic_bg">#0b1622</color>
    <style name="Chip">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">2dp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingTop">7dp</item>
        <item name="android:paddingBottom">7dp</item>
        <item name="android:textSize">11sp</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">#9FE8FF</item>
        <item name="android:background">#1C2A3D</item>
    </style>
</resources>
