<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B1622"
    android:orientation="vertical"
    android:padding="6dp">

    <ImageView
        android:id="@+id/plan"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:adjustViewBounds="true"
        android:scaleType="fitCenter" />

    <TextView
        android:id="@+id/msg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="4dp"
        android:text=""
        android:textColor="#9FE8FF"
        android:textSize="11sp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

        <TextView android:id="@+id/c0" style="@style/Chip" />
        <TextView android:id="@+id/c1" style="@style/Chip" />
        <TextView android:id="@+id/c2" style="@style/Chip" />
        <TextView android:id="@+id/c3" style="@style/Chip" />
        <TextView android:id="@+id/c4" style="@style/Chip" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:orientation="horizontal">

        <TextView android:id="@+id/c5" style="@style/Chip" />
        <TextView android:id="@+id/c6" style="@style/Chip" />
        <TextView android:id="@+id/c7" style="@style/Chip" />
        <TextView android:id="@+id/r" style="@style/Chip" android:text="⟳" />
        <TextView android:id="@+id/g" style="@style/Chip" android:text="⚙" />
    </LinearLayout>
</LinearLayout>
